---
# Copie este arquivo para vault.yml e preencha os valores reais:
#
#   cp inventory/group_vars/all/vault.yml.example inventory/group_vars/all/vault.yml
#   ansible-vault edit inventory/group_vars/all/vault.yml
#
# vault.yml fica fora do git (.gitignore). Os nomes das variáveis abaixo são
# os mesmos usados em inventory/group_vars/all/vars.yml — se renomear aqui,
# renomee lá também.

# Token da API do Proxmox (ansible@pve / ansible-token), usado pelos módulos
# community.proxmox.*
vault_proxmox_token_secret: "CHANGE-ME"

# Chave de autorização reutilizável e sem expiração, gerada em
# https://login.tailscale.com/admin/settings/oauth
vault_tailscale_authkey: "tskey-auth-CHANGE-ME"

# Senha do Postgres do Forgejo. Vai parar em texto no
# {{ forgejo_dir }}/docker-compose.yml do container, então use uma senha
# exclusiva para este stack.
vault_forgejo_db_password: "CHANGE-ME"

# Acesso independente ao repositório Borg usado pelo backup do Forgejo.
# O Pi de recuperação precisa desses valores sem depender do Forgejo ou
# Vaultwarden restaurado.
vault_forgejo_borg_repo: "ssh://host.repo.borgbase.com/./repo"
vault_forgejo_borg_passcommand: "cat /root/.borg-pass"
vault_forgejo_borg_ssh_key: "/root/.ssh/id_ed25519"
vault_forgejo_borg_password: |-
  CHANGE-ME
vault_forgejo_borg_ssh_private_key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  CHANGE-ME
  -----END OPENSSH PRIVATE KEY-----
# Chave pública do servidor Borg, sem o hostname no início.
vault_forgejo_borg_known_host_key: "ssh-ed25519 AAAA..."

# Token do Cloudflare para DNS-01 (https://dash.cloudflare.com/profile/api-tokens).
# Scope: Zone:DNS:Edit em todas as zonas que os caddies (VPS + homelab)
# atendem — mínimo: nextlevelcode.pro e lab.nextlevelcode.pro.
vault_caddy_cloudflare_token: "CHANGE-ME"

# Hash argon2 do token admin do Vaultwarden (painel /admin). Gere com:
#   docker run --rm vaultwarden/server /vaultwarden hash
# Vai parar em texto no {{ vaultwarden_dir }}/docker-compose.yml do
# container. Guarde também fora do Vaultwarden (em local independente
# do serviço) para recuperação no Pi.
vault_vaultwarden_admin_token: "CHANGE-ME"

# Credenciais SMTP do Vaultwarden (Proton Mail). O username é o email
# completo da conta Proton que vai enviar as notificações.
vault_vaultwarden_smtp_username: "vaultwarden@nextlevelcode.pro"
vault_vaultwarden_smtp_password: "CHANGE-ME"

# Stack Arr (Pi). As API keys são geradas por cada app (Settings → General
# → API Key) e a senha é a da WebUI do qBittorrent: nada disso configura os
# apps, só deixa o decluttarr falar com eles.
vault_arr_radarr_api_key: "CHANGE-ME"
vault_arr_sonarr_api_key: "CHANGE-ME"
vault_arr_qbit_username: "admin"
vault_arr_qbit_password: "CHANGE-ME"
