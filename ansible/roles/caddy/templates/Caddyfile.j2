{
    email {{ caddy_email }}
}

# Domínio wildcard privado. Só acessível de dentro da tailnet via
# Tailscale split DNS. O catch-all 404 segura os hosts não mapeados.
*.{{ caddy_domain }} {
    tls {
        dns cloudflare {env.{{ caddy_cloudflare_env_var }}}
    }

    # Serviço novo do Pi entra em caddy_lab_pi_routes (group_vars/all), que
    # o Caddy reserva do Pi também lê. O resto, handle aqui.
    @vault host vault.{{ caddy_domain }}
    handle @vault {
        reverse_proxy vaultwarden-lxc:8080
    }

    @bread_of_life host bread-of-life.{{ caddy_domain }}
    handle @bread_of_life {
{% if caddy_bread_of_life_client_ips %}
        @bread_of_life_clientes remote_ip {{ caddy_bread_of_life_client_ips | join(' ') }}
        handle @bread_of_life_clientes {
            reverse_proxy bread-of-life-lxc:4000
        }
{% endif %}
        handle {
            respond 403
        }
    }

    # --- Raspberry Pi: portas publicadas no IP Tailscale (caddy_lab_pi_routes) ---
{% for route in caddy_lab_pi_routes %}

    @{{ route.host }} host {{ route.host }}.{{ caddy_domain }}
    handle @{{ route.host }} {
        reverse_proxy nextlevelcode:{{ route.port }}
    }
{% endfor %}

    handle {
        respond 404
    }
}

