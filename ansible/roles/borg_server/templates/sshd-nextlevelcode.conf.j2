# Gerido pelo Ansible (roles/borg_server) — não editar à mão.
# Nome com 00 de propósito: no sshd vale o primeiro valor lido.
#
# Só entram o Ansible e o borg, por chave e vindos da tailnet. Pelo
# AllowUsers, e não pelo ListenAddress no IP Tailscale: o sshd sobe antes do
# tailscaled no boot e falharia ao escutar num IP que ainda não existe.
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin no
X11Forwarding no
AllowUsers{% for user in [borg_server_admin_user, borg_server_user] %}{% for net in borg_server_allowed_networks %} {{ user }}@{{ net }}{% endfor %}{% endfor %}

