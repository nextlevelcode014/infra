# Gerido pelo Ansible — não editar à mão. É o env_file do immich-server e do
# machine-learning, e o Compose interpola '$' aqui dentro.
TS_AUTHKEY={{ immich_ts_authkey if immich_tailscale_sidecar else '' }}
TS_TAILNET={{ immich_ts_tailnet }}
TS_IP={{ ts_ip }}

PUID={{ puid }}
PGID={{ pgid }}

IMMICH_VERSION={{ immich_version }}

UPLOAD_LOCATION={{ immich_upload_location }}
DB_DATA_LOCATION={{ immich_db_data_location }}

# postgres, não 'immich': os dumps do Immich carregam 'OWNER TO postgres'.
DB_USERNAME={{ immich_db_username }}
DB_DATABASE_NAME={{ immich_db_database_name }}
DB_PASSWORD={{ immich_db_password }}
