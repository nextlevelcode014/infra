#!/usr/bin/env bash
# Gerido pelo Ansible — não editar à mão. Origem: o backup-immich.sh do Pi.
#
# Não para os containers: o banco sai consistente pelo pg_dump, e as fotos são
# arquivos que não mudam depois de gravados. O dump fica dentro do
# UPLOAD_LOCATION, então vai no mesmo archive que as fotos.
set -euo pipefail

upload_location="{{ immich_upload_location }}"
timestamp="$(date +%Y-%m-%d_%H-%M-%S)"

export BORG_PASSCOMMAND="{{ borg_passcommand }}"
export BORG_RSH="{{ borg_rsh }}"

[[ -d "$upload_location" ]] || { echo "ERRO: $upload_location não encontrado"; exit 1; }

echo "[$timestamp] Iniciando backup do Immich..."

mkdir -p "$upload_location/database-backup"
# Sem -t: com TTY o dump sai com \r\n e o \r pode cair dentro dos dados do COPY.
docker exec immich_postgres pg_dump --clean --if-exists \
    --dbname "{{ immich_db_database_name }}" --username "{{ immich_db_username }}" \
    > "$upload_location/database-backup/immich-database.sql"
echo "[$(date +%H:%M:%S)] Dump: $(du -h "$upload_location/database-backup/immich-database.sql" | cut -f1)"

# Sem --compression: fotos e vídeos já vêm comprimidos. Thumbs e vídeos
# re-encodados o Immich gera de novo a partir dos originais.
borg create --lock-wait {{ borg_lock_wait }} \
    --exclude "$upload_location/thumbs/" \
    --exclude "$upload_location/encoded-video/" \
    "{{ borg_repo }}::immich-$timestamp" \
    "$upload_location"

borg prune --lock-wait {{ borg_lock_wait }} --glob-archives 'immich-*' "{{ borg_repo }}" {{ borg_backup_retention }}
borg compact --lock-wait {{ borg_lock_wait }} "{{ borg_repo }}"

echo "[$(date +%H:%M:%S)] Backup concluído com sucesso!"
