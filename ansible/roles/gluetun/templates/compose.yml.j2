services:
  gluetun:
    image: {{ gluetun_image }}
    container_name: gluetun
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      - VPN_SERVICE_PROVIDER=protonvpn
      - VPN_TYPE=wireguard
      - WIREGUARD_PRIVATE_KEY=${WIREGUARD_PRIVATE_KEY}
      - WIREGUARD_ADDRESSES=${WIREGUARD_ADDRESSES}
      # Sem filtro o gluetun sorteia qualquer servidor Proton, inclusive os
      # gratuitos, que bloqueiam P2P: a conexão é pausada e o qBittorrent e o
      # SearXNG ficam sem rede. Na Proton, port forwarding = servidor P2P.
      - PORT_FORWARD_ONLY=on
      - HTTPPROXY=on
      - HTTPPROXY_LISTENING_ADDRESS=:8888
      - HEALTH_TARGET_ADDRESS=1.1.1.1:443
      - TZ=America/Sao_Paulo
    ports:
      - "8888:8888"     # proxy HTTP (SearXNG)
      - "8001:8000"     # control server
      - "8090:8090"     # qBittorrent WebUI
      - "6881:6881"     # qBittorrent TCP
      - "6881:6881/udp" # qBittorrent DHT
      # WebUI do SearXNG, só no IP Tailscale: o Caddy do Proxmox chega por ali.
      - "${TS_IP:?defina TS_IP no .env}:8082:8080"
    healthcheck:
      test: ["CMD", "/gluetun-entrypoint", "healthcheck"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
    restart: unless-stopped
    networks:
      - vpn_net
      - medianet

networks:
  vpn_net:
    name: vpn_net
    external: true
  medianet:
    name: medianet
    external: true
