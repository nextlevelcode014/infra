# Gerido pelo Ansible — não editar à mão.
# O Compose interpola '$' também no env_file: '$v7' numa senha vira a variável
# v7 (vazia), e a senha chega cortada. '$$' é o '$' literal.
AUTOKUMA__KUMA__USERNAME={{ uptime_kuma_admin_username | replace('$', '$$') }}
AUTOKUMA__KUMA__PASSWORD={{ uptime_kuma_admin_password | replace('$', '$$') }}
