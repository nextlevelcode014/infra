#!/usr/bin/env bash
# Gerido pelo Ansible — não editar à mão.
#
# Para o Uptime Kuma por alguns segundos enquanto o Borg copia o SQLite.
# Monitores, avisos e histórico estão todos nesse banco.
set -euo pipefail

compose_file="{{ uptime_kuma_dir }}/compose.yml"
timestamp="$(date +%Y-%m-%d_%H-%M-%S)"

export BORG_PASSCOMMAND="{{ borg_passcommand }}"
export BORG_RSH="{{ borg_rsh }}"

cleanup() {
    exit_code=$?
    if [[ "$exit_code" -ne 0 ]]; then
        echo "ERRO detectado (código $exit_code). Subindo o Uptime Kuma..."
        docker compose -f "$compose_file" start uptime-kuma
    fi
}
trap cleanup EXIT

echo "[$timestamp] Iniciando backup do Uptime Kuma..."
docker compose -f "$compose_file" stop uptime-kuma

borg create --lock-wait {{ borg_lock_wait }} \
    --compression "{{ borg_backup_compression }}" \
    "{{ borg_repo }}::uptime-kuma-$timestamp" \
    "{{ uptime_kuma_dir }}/data"

docker compose -f "$compose_file" start uptime-kuma
borg prune --lock-wait {{ borg_lock_wait }} --glob-archives 'uptime-kuma-*' "{{ borg_repo }}" {{ borg_backup_retention }}
borg compact --lock-wait {{ borg_lock_wait }} "{{ borg_repo }}"

echo "[$(date +%H:%M:%S)] Backup concluído com sucesso!"
