#!/usr/bin/env bash
# Gerido pelo Ansible — não editar à mão.
#
# Para só o fmd (o sidecar e o Funnel continuam) enquanto o Borg copia o
# SQLite, que está em modo WAL. São alguns segundos.
set -euo pipefail

compose_file="{{ fmd_dir }}/compose.yml"
timestamp="$(date +%Y-%m-%d_%H-%M-%S)"

export BORG_PASSCOMMAND="{{ borg_passcommand }}"
export BORG_RSH="{{ borg_rsh }}"

cleanup() {
    exit_code=$?
    if [[ "$exit_code" -ne 0 ]]; then
        echo "ERRO detectado (código $exit_code). Subindo o fmd..."
        docker compose -f "$compose_file" start fmd
    fi
}
trap cleanup EXIT

echo "[$timestamp] Iniciando backup do FMD..."
docker compose -f "$compose_file" stop fmd

borg create --lock-wait {{ borg_lock_wait }} \
    --compression "{{ borg_backup_compression }}" \
    "{{ borg_repo }}::fmd-$timestamp" \
    "{{ fmd_data_dir }}/fmddata"

docker compose -f "$compose_file" start fmd
borg prune --lock-wait {{ borg_lock_wait }} --glob-archives 'fmd-*' "{{ borg_repo }}" {{ borg_backup_retention }}
borg compact --lock-wait {{ borg_lock_wait }} "{{ borg_repo }}"

echo "[$(date +%H:%M:%S)] Backup concluído com sucesso!"
