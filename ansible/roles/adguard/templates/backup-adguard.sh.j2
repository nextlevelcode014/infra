#!/usr/bin/env bash
# Gerido pelo Ansible — não editar à mão.
#
# Não para o AdGuard: parar o DNS derruba a rede da casa inteira. A config
# (AdGuardHome.yaml) é um arquivo pequeno, e o stats.db, se sair inconsistente,
# só perde estatística.
set -euo pipefail

data_dir="{{ adguard_data_dir }}"
timestamp="$(date +%Y-%m-%d_%H-%M-%S)"

export BORG_PASSCOMMAND="{{ borg_passcommand }}"
export BORG_RSH="{{ borg_rsh }}"

echo "[$timestamp] Iniciando backup do AdGuard..."

borg create --lock-wait {{ borg_lock_wait }} \
    --compression "{{ borg_backup_compression }}" \
    --exclude "$data_dir/work/data/querylog.json*" \
    "{{ borg_repo }}::adguard-$timestamp" \
    "$data_dir/conf" \
    "$data_dir/work"

borg prune --lock-wait {{ borg_lock_wait }} --glob-archives 'adguard-*' "{{ borg_repo }}" {{ borg_backup_retention }}
borg compact --lock-wait {{ borg_lock_wait }} "{{ borg_repo }}"

echo "[$(date +%H:%M:%S)] Backup concluído com sucesso!"
