# Gerido pelo Ansible — não editar à mão. Origem: self-hosted/searxng/compose.yml,
# sem o sidecar Tailscale: o acesso é pelo Caddy, na porta 8082 que o gluetun
# publica (o searxng-core vive na netns dele).
name: searxng

services:
  core:
    container_name: searxng-core
    image: docker.io/searxng/searxng:latest
    restart: always
    network_mode: "container:gluetun"
    volumes:
      - {{ searxng_config_dir }}/:/etc/searxng/:Z
      - core-data:/var/cache/searxng/

  valkey:
    container_name: searxng-valkey
    image: docker.io/valkey/valkey:9-alpine
    command: valkey-server --save 30 1 --loglevel warning
    restart: always
    volumes:
      - valkey-data:/data/
    networks:
      - vpn_net

volumes:
  core-data:
  valkey-data:

networks:
  vpn_net:
    name: vpn_net
    external: true
