# Gerido pelo Ansible — não editar à mão. Mudou uma engine? Edite aqui e
# reaplique (docs/searxng.md).
# Read the documentation before extending the defaults:
# https://docs.searxng.org/admin/settings/

use_default_settings: true

server:
  secret_key: "{{ searxng_secret_key }}"
  image_proxy: true

valkey:
  url: valkey://valkey:6379/0

ui:
  static_use_hash: true

engines:
  - name: startpage
    disabled: true
  - name: 360search
    disabled: true
  - name: presearch
    disabled: true
  - name: presearch videos
    disabled: true
  - name: google
    disabled: true
  - name: google images
    disabled: true
  - name: google news
    disabled: true
  - name: google videos
    disabled: true
  - name: google scholar
    disabled: true
  - name: github
    disabled: false
  - name: stackoverflow
    disabled: false
  - name: pypi
    disabled: false

  # Acadêmico
  - name: arxiv
    disabled: false
  - name: semantic scholar
    disabled: false
  - name: pubmed
    disabled: false

  # Pela VPN, o Brave responde com timeout ou com uma página sem resultados
  # ("unexpected crash" na interface, ValueError em /stats/errors). O
  # Pinterest falha sempre no parser. Religar é trocar para false e conferir
  # o /stats depois de algumas buscas.
  - name: brave
    disabled: true
  - name: brave.images
    disabled: true
  - name: brave.videos
    disabled: true
  - name: brave.news
    disabled: true
  - name: pinterest
    disabled: true

  - name: ahmia
    disabled: true
  - name: torch
    disabled: true


outgoing:
  request_timeout: 6.0
  max_request_timeout: 15.0
