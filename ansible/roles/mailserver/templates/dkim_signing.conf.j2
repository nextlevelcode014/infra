enabled = true;
sign_authenticated = true;
sign_local = false;
use_domain = "header";
use_esld = false;
use_redis = false;
allow_username_mismatch = true;
check_pubkey = true;
try_fallback = false;
domain {
{% for dominio in mailserver_dominios_ativos %}
  "{{ dominio }}" {
    selector = "{{ mailserver_seletor }}";
    path = "/tmp/docker-mailserver/rspamd/dkim/{{ dominio }}-{{ mailserver_seletor }}.private";
  }
{% endfor %}
}
