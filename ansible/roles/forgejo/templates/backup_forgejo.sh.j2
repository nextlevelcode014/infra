#!/usr/bin/env bash
set -euo pipefail

compose_file="{{ forgejo_dir }}/docker-compose.yml"
data_dir="{{ forgejo_dir }}/forgejo"
db_container="forgejo-db"
db_user="forgejo"
db_name="forgejo"
db_dump="/tmp/forgejo_db_dump.sql"
timestamp="$(date +%Y-%m-%d_%H-%M-%S)"

export BORG_PASSCOMMAND="{{ borg_passcommand }}"
export BORG_RSH="{{ borg_rsh }}"

cleanup() {
    exit_code=$?
    if [[ "$exit_code" -ne 0 ]]; then
        echo "ERRO detectado (código $exit_code). Reiniciando containers..."
        docker compose -f "$compose_file" up -d
    fi
    rm -f "$db_dump"
}
trap cleanup EXIT

echo "[$timestamp] Iniciando backup do Forgejo..."
docker exec "$db_container" pg_dump -U "$db_user" "$db_name" > "$db_dump"
docker compose -f "$compose_file" down

borg create --lock-wait {{ borg_lock_wait }} \
    --compression "{{ borg_backup_compression }}" \
    --exclude '*.tmp' \
    --exclude '*.log' \
    --exclude 'cache/*' \
    "{{ borg_repo }}::forgejo-$timestamp" \
    "$data_dir" \
    "$db_dump"

docker compose -f "$compose_file" up -d
borg prune --lock-wait {{ borg_lock_wait }} --glob-archives 'forgejo-*' "{{ borg_repo }}" {{ borg_backup_retention }}
borg compact --lock-wait {{ borg_lock_wait }} "{{ borg_repo }}"

echo "[$(date +%Y-%m-%d_%H-%M-%S)] Backup concluído com sucesso!"
