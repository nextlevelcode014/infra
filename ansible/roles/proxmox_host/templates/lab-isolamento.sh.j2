#!/bin/sh
# Gerido pelo Ansible (roles/proxmox_host) — não editar à mão.
# Isolamento da rede do lab (ADR 0021). As VMs do lab só saem para a
# internet: não abrem conexão com o host, com a vmbr1 dos LXCs, com a LAN
# nem com a tailnet, e ninguém abre conexão com elas. O acesso de
# administração é o SSH saltando pelo host, que sai do próprio host (OUTPUT)
# e por isso não passa por aqui.
#
# As regras moram em chains próprias, esvaziadas e refeitas a cada "ligar":
# rodar duas vezes dá o mesmo resultado.
set -eu

BRIDGE={{ proxmox_lab_bridge }}
SUBNET={{ proxmox_lab_subnet }}
UPLINK={{ proxmox_lxc_uplink }}

tirar_saltos() {
	iptables -D FORWARD -j LAB-FORWARD 2>/dev/null || true
	iptables -D INPUT -j LAB-INPUT 2>/dev/null || true
	iptables -t nat -D POSTROUTING -s "$SUBNET" -o "$UPLINK" -j MASQUERADE 2>/dev/null || true
}

case "${1:-}" in
ligar)
	iptables -N LAB-FORWARD 2>/dev/null || iptables -F LAB-FORWARD
	iptables -N LAB-INPUT 2>/dev/null || iptables -F LAB-INPUT

	# Resposta a conexão que já existe passa; o resto decide pela origem.
	iptables -A LAB-FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN
	# VM do lab com VM do lab, dentro da bridge: só aparece aqui se o
	# br_netfilter estiver ligado, e não sai do lab.
	iptables -A LAB-FORWARD -i "$BRIDGE" -o "$BRIDGE" -j RETURN
	# Ninguém abre conexão para dentro do lab.
	iptables -A LAB-FORWARD -o "$BRIDGE" -j DROP
	# Do lab, só pela vmbr0 e só para fora das faixas privadas.
	iptables -A LAB-FORWARD -i "$BRIDGE" ! -o "$UPLINK" -j DROP
{% for destino in proxmox_lab_destinos_bloqueados %}
	iptables -A LAB-FORWARD -i "$BRIDGE" -d {{ destino }} -j DROP
{% endfor %}

	# O host também é produção: o lab não chega à API nem ao SSH dele.
	iptables -A LAB-INPUT -i "$BRIDGE" -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN
	iptables -A LAB-INPUT -i "$BRIDGE" -j DROP

	# No topo: vem antes de qualquer ACCEPT que já esteja nas chains.
	tirar_saltos
	iptables -I FORWARD 1 -j LAB-FORWARD
	iptables -I INPUT 1 -j LAB-INPUT
	iptables -t nat -A POSTROUTING -s "$SUBNET" -o "$UPLINK" -j MASQUERADE
	;;
desligar)
	tirar_saltos
	iptables -F LAB-FORWARD 2>/dev/null || true
	iptables -X LAB-FORWARD 2>/dev/null || true
	iptables -F LAB-INPUT 2>/dev/null || true
	iptables -X LAB-INPUT 2>/dev/null || true
	;;
*)
	echo "uso: $0 ligar|desligar" >&2
	exit 2
	;;
esac
