// Política de acesso (ACL) da tailnet — cópia de referência.
//
// O console do Tailscale é quem aplica; este arquivo é o que foi revisado em PR.
// Mudou aqui → cole no console depois do merge. Mudou no console → traga pra cá.
// Passo a passo em tailscale/README.md.
{
    "groups": {},

    "ipsets": {},

    // IPs Tailscale dos desktops de administração. Ficam sem tag (user-owned).
    // O IP real não fica no repo: troque o placeholder ao colar no console
    // (tailscale/README.md).
    "hosts": {
        "infra-admin-1": "<ip-tailscale-do-desktop>",
        // Borg offsite: desktop de uso normal fora de casa, por isso sem
        // tag, como o de administração (docs/borg-offsite.md).
        "borg-offsite": "<ip-tailscale-do-borg-offsite>",
    },

    "grants": [
        // --- Pessoas -------------------------------------------------------
        // Admin/owner: acesso total aos próprios dispositivos sem tag.
        {
            "src": ["autogroup:admin", "autogroup:owner"],
            "dst": ["autogroup:self"],
            "ip":  ["*"],
        },
        // Exit nodes (vpn-exit, Mullvad).
        {
            "src": ["autogroup:member"],
            "dst": ["autogroup:internet"],
            "ip":  ["*"],
        },
        // Serviços web: só HTTPS, pelos três Caddys (Proxmox: *.lab; VPS:
        // uptime.lab; Pi: reserva do *.lab quando o Proxmox cai).
        {
            "src": ["autogroup:member"],
            "dst": ["tag:caddy", "tag:caddy-vps", "tag:pi"],
            "ip":  ["tcp:443"],
        },
        // Pi direto: DNS do AdGuard e o coturn do Talk (TURN/STUN + relay; o
        // intervalo é nextcloud_turn_min/max_port em ansible/).
        {
            "src": ["autogroup:member"],
            "dst": ["tag:pi"],
            "ip":  ["tcp:53", "udp:53", "udp:3479", "tcp:3479", "udp:49160-49200"],
        },
        // SSH do Git, só no LXC do Forgejo.
        {
            "src": ["autogroup:member"],
            "dst": ["tag:forgejo"],
            "ip":  ["tcp:2222"],
        },
        // FMD pelo nome da tailnet (fmd.<tailnet>.ts.net). De fora da tailnet,
        // o mesmo nome chega pelo Funnel, que não passa por aqui.
        {
            "src": ["autogroup:member"],
            "dst": ["tag:public"],
            "ip":  ["tcp:443"],
        },

        // --- Administração: só pelos desktops listados em "hosts" ------------
        {
            "src": ["infra-admin-1"],
            "dst": ["tag:proxmox-lxc", "tag:caddy", "tag:pi", "tag:vps"],
            "ip":  ["tcp:22"],
        },
        {
            "src": ["infra-admin-1"],
            "dst": ["tag:proxmox"],
            "ip":  ["tcp:22", "tcp:443", "tcp:8006"],
        },
        // Interface do Nextcloud AIO (tailscale serve do host do Pi).
        {
            "src": ["infra-admin-1"],
            "dst": ["tag:pi"],
            "ip":  ["tcp:8080"],
        },
        // Laboratório (repo lab): descartável, qualquer porta. O caminho
        // inverso não existe: nenhum grant tem tag:lab como origem.
        {
            "src": ["infra-admin-1"],
            "dst": ["tag:lab"],
            "ip":  ["*"],
        },
        // CI do lab (GitHub Actions, nó efêmero): só pede deploy ao Coolify de
        // uma máquina do lab. Mais nada, nem SSH.
        {
            "src": ["tag:lab-ci"],
            "dst": ["tag:lab"],
            "ip":  ["tcp:8000"],
        },

        // --- Caddy do Proxmox -> backends -------------------------------------
        // Forgejo (3000) e Vaultwarden (8080) nos LXCs.
        {
            "src": ["tag:caddy"],
            "dst": ["tag:proxmox-lxc"],
            "ip":  ["tcp:3000", "tcp:8080"],
        },
        // Portas publicadas no IP Tailscale do Pi, uma por rota do Caddyfile.
        {
            "src": ["tag:caddy"],
            "dst": ["tag:pi"],
            "ip": [
                "tcp:8096",  // jellyfin
                "tcp:5055",  // jellyseerr
                "tcp:8989",  // sonarr
                "tcp:7878",  // radarr
                "tcp:9696",  // prowlarr
                "tcp:6767",  // bazarr
                "tcp:6868",  // profilarr
                "tcp:8090",  // qbittorrent (publicada pelo gluetun)
                "tcp:8081",  // dozzle
                "tcp:8082",  // searxng (publicada pelo gluetun)
                "tcp:8084",  // adguard (web)
                "tcp:8085",  // fmd (publicada pelo sidecar)
                "tcp:2283",  // immich
                "tcp:11000", // nextcloud (apache do AIO)
            ],
        },
        // O Nextcloud testa o próprio HPB pelo domínio, que passa pelo Caddy.
        {
            "src": ["tag:pi"],
            "dst": ["tag:caddy"],
            "ip":  ["tcp:443"],
        },

        // Backup do Immich (borgmatic) e do Nextcloud (Borg do AIO) no
        // Borg offsite. Lá o sshd só aceita o usuário borg, preso ao
        // borg serve de cada repositório.
        {
            "src": ["tag:pi"],
            "dst": ["borg-offsite"],
            "ip":  ["tcp:22"],
        },

        // --- VPS --------------------------------------------------------------
        // Caddy público -> Forgejo de produção (forge.nextlevelcode.pro).
        {
            "src": ["tag:caddy-vps"],
            "dst": ["tag:forgejo"],
            "ip":  ["tcp:3000"],
        },
        // Uptime Kuma: *.lab pelo Caddy (o do Proxmox, ou o reserva do Pi
        // quando o *.lab aponta para ele), DNS do AdGuard, ping e SSH do
        // Forgejo.
        {
            "src": ["tag:vps"],
            "dst": ["tag:caddy", "tag:pi"],
            "ip":  ["tcp:443"],
        },
        {
            "src": ["tag:vps"],
            "dst": ["tag:pi"],
            "ip":  ["tcp:53", "udp:53"],
        },
        {
            "src": ["tag:vps"],
            "dst": ["tag:pi", "tag:proxmox"],
            "ip":  ["icmp:*"],
        },
        {
            "src": ["tag:vps"],
            "dst": ["tag:forgejo"],
            "ip":  ["tcp:2222"],
        },
        // Backup -> Uptime Kuma: o borgmatic avisa o monitor push no fim de
        // cada backup (uptime.lab, pelo Caddy da VPS).
        {
            "src": ["tag:pi", "tag:proxmox-lxc"],
            "dst": ["tag:caddy-vps"],
            "ip":  ["tcp:443"],
        },

        // CONTINGÊNCIA — ATIVO enquanto proxmox_fora for true
        // (docs/pi-recuperacao.md). Na volta, comentar de novo e devolver
        // tag:pi:3000 ao deny de tag:caddy-vps nos tests. O forge público
        // (Anubis na VPS) passa a apontar para o Forgejo do Pi. O *.lab não
        // passa mais pela VPS: quem assume é o Caddy reserva do Pi.
        {
          "src": ["tag:caddy-vps"],
          "dst": ["tag:pi"],
          "ip":  ["tcp:3000"],
        },
        // SSH do Git no Pi, para você e para o monitor do Uptime Kuma.
        {
          "src": ["autogroup:member", "tag:vps"],
          "dst": ["tag:pi"],
          "ip":  ["tcp:2222"],
        },
    ],

    "ssh": [
        {
            "src":    ["autogroup:admin", "autogroup:owner"],
            "dst":    ["autogroup:self"],
            "users":  ["autogroup:nonroot"],
            "action": "accept",
        },
        // Infra: identidade humana + reautenticação (check). O grant de rede
        // acima limita quais dispositivos chegam à porta 22.
        {
            "src":    ["autogroup:admin", "autogroup:owner"],
            "dst":    ["tag:proxmox-lxc", "tag:caddy"],
            "users":  ["root"],
            "action": "check",
        },
        {
            "src":    ["autogroup:admin", "autogroup:owner"],
            "dst":    ["tag:pi"],
            "users":  ["ubuntu"],
            "action": "check",
        },
        {
            "src":    ["autogroup:admin", "autogroup:owner"],
            "dst":    ["tag:vps"],
            "users":  ["hetzner"],
            "action": "check",
        },
        {
            "src":    ["autogroup:admin", "autogroup:owner"],
            "dst":    ["tag:proxmox"],
            "users":  ["autogroup:nonroot", "root"],
            "action": "check",
        },
        // Lab: accept, sem reautenticação. É descartável, e o grant acima já
        // limita quem chega à porta 22 ao desktop de administração.
        {
            "src":    ["autogroup:admin", "autogroup:owner"],
            "dst":    ["tag:lab"],
            "users":  ["autogroup:nonroot", "root"],
            "action": "accept",
        },
    ],

    "autoApprovers": {
        "exitNode": ["autogroup:admin", "autogroup:owner"],
    },

    "tagOwners": {
        // Nós Tailscale em container: o sidecar do FMD e o exit node.
        "tag:containers": ["autogroup:admin"],
        // Opt-in do Funnel (fmd): só funciona junto com AllowFunnel no
        // ts-serve.json do serviço.
        "tag:public": ["autogroup:admin"],
        // Host do Proxmox. Tag em vez de conta de usuário: nó com tag não
        // expira a chave (com conta, o nó cai da tailnet a cada 180 dias).
        "tag:proxmox":     ["autogroup:admin"],
        "tag:proxmox-lxc": ["autogroup:admin"],
        "tag:forgejo":     ["autogroup:admin"],
        "tag:caddy":       ["autogroup:admin"],
        "tag:pi":          ["autogroup:admin"],
        "tag:vps":         ["autogroup:admin"],
        "tag:caddy-vps":   ["autogroup:admin"],
        // Máquinas do repo lab (auth key efêmera). Não alcançam nada da infra.
        "tag:lab":         ["autogroup:admin"],
        // Runner do GitHub Actions dos testes do lab (OAuth client com esta
        // tag, auth key efêmera por job). Só chega no Coolify do lab.
        "tag:lab-ci":      ["autogroup:admin"],
    },

    "nodeAttrs": [
        // Funnel só para quem optou explicitamente via tag.
        {"target": ["tag:public"], "attr": ["funnel"]},
    ],

    // Rodam a cada save no console: se uma edição reabrir um acesso, o save
    // falha em vez de passar despercebido.
    "tests": [
        // Nós em container (FMD, exit node) não alcançam nada da infra.
        {
            "src": "tag:containers",
            "deny": [
                "tag:pi:22",
                "tag:pi:6868",
                "tag:vps:22",
                "tag:proxmox:22",
                "tag:proxmox:8006",
                "tag:proxmox-lxc:8080",
            ],
        },
        {
            "src":  "tag:public",
            "deny": ["tag:pi:22", "tag:pi:53", "tag:caddy:443"],
        },
        // O Caddy do Proxmox alcança os backends, e só eles.
        {
            "src":    "tag:caddy",
            "accept": ["tag:pi:6868", "tag:pi:11000", "tag:proxmox-lxc:3000", "tag:proxmox-lxc:8080"],
            "deny":   ["tag:pi:22", "tag:pi:53", "tag:proxmox:8006"],
        },
        // O Caddy público só chega no Forgejo; o Vaultwarden não é público,
        // nem na contingência (o do Pi fica atrás do Caddy reserva do Pi).
        {
            "src":    "tag:caddy-vps",
            "accept": ["tag:forgejo:3000"],
            "deny":   ["tag:proxmox-lxc:8080", "tag:pi:8083", "tag:pi:8096"],
        },
        // O monitor alcança o que monitora, e não administra nada.
        {
            "src":    "tag:vps",
            "accept": ["tag:caddy:443", "tag:pi:443", "tag:pi:53", "tag:forgejo:2222"],
            "deny":   ["tag:pi:22", "tag:proxmox:22", "tag:proxmox:8006", "borg-offsite:22"],
        },
        // O Pi só fala com o Caddy (HPB do Nextcloud), com o Uptime Kuma
        // (aviso de backup) e com o Borg offsite.
        {
            "src":    "tag:pi",
            "accept": ["tag:caddy:443", "tag:caddy-vps:443", "borg-offsite:22"],
            "deny":   ["tag:proxmox:22", "tag:proxmox-lxc:22", "tag:vps:22"],
        },
        // O lab não alcança nada da infra.
        {
            "src":  "tag:lab",
            "deny": [
                "tag:pi:22", "tag:pi:53", "tag:pi:2222",
                "tag:proxmox:22", "tag:proxmox:8006",
                "tag:proxmox-lxc:22", "tag:proxmox-lxc:8080",
                "tag:forgejo:2222", "tag:forgejo:3000",
                "tag:caddy:443", "tag:caddy-vps:443",
                "tag:vps:22", "borg-offsite:22",
            ],
        },
        // O CI do lab chega no Coolify do lab, e em mais nada.
        {
            "src":    "tag:lab-ci",
            "accept": ["tag:lab:8000"],
            "deny": [
                "tag:lab:22",
                "tag:pi:22", "tag:pi:443",
                "tag:proxmox:22", "tag:proxmox:8006",
                "tag:proxmox-lxc:22", "tag:forgejo:3000",
                "tag:caddy:443", "tag:caddy-vps:443",
                "tag:vps:22",
            ],
        },
        // Os LXCs só avisam o Uptime Kuma; não administram a VPS.
        {
            "src":    "tag:proxmox-lxc",
            "accept": ["tag:caddy-vps:443"],
            "deny":   ["tag:vps:22", "tag:proxmox:8006"],
        },
    ],
}
